        ref: "overview_ref01"
      }

      op: "create"
    }

    {
      input: {
        ref: "overview_ref01",
        srcdatavar: "overview_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-overview_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOverviewFlow"
}